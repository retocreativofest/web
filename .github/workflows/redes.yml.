name: Seguidores de Instagram y TikTok
on:
  schedule:
    - cron: '41 */6 * * *'
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  actualizar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python scripts/redes.py
      - name: Guardar si cambió
        run: |
          if ! git diff --quiet data/redes.json; then
            git config user.name "rcf-bot"
            git config user.email "rcf-bot@users.noreply.github.com"
            git add data/redes.json
            git commit -m "Actualiza seguidores de redes"
            git pull --rebase
            git push
          fi
